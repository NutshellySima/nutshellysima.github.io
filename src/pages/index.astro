---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  awards,
  avatar,
  education,
  experience,
  highlights,
  lastUpdated,
  machineReadableResources,
  profile,
  publications,
  reviewing,
  talks,
  writeups,
} from '../data/profile';

const scholarUrl = 'https://scholar.google.com/citations?user=8-HD_IEAAAAJ&hl=en';
const linkedinUrl = 'https://www.linkedin.com/in/chijun-sima/';

const navItems = [
  { id: 'publications', label: 'Publications' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'talks', label: 'Talks' },
  { id: 'service', label: 'Service & Awards' },
  { id: 'writeups', label: 'Write-ups' },
];

const sectionNumber = (id: string) => String(navItems.findIndex((item) => item.id === id) + 1).padStart(2, '0');
---
<BaseLayout>
  <a href="#main" class="skip-link">Skip to main content</a>

  <header class="topbar no-print">
    <div class="topbar-inner">
      <a class="brand" href="#top" aria-label="Chijun Sima, back to top">
        <span class="brand-mark" aria-hidden="true">CS</span>
        <span class="brand-name">Chijun Sima</span>
      </a>
      <nav class="topnav" aria-label="Page sections">
        <ul>
          {navItems.map((item) => (
            <li><a href={`#${item.id}`} data-nav={item.id}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <div class="shell" itemscope itemtype="https://schema.org/Person">
    <meta itemprop="name" content="Chijun Sima" />
    <meta itemprop="url" content="https://www.chijunsima.com" />

    <main id="main" class="content" tabindex="-1">
      <!-- ── Hero ── -->
      <section id="top" class="hero" aria-label="About">
        <div class="hero-copy">
          <p class="eyebrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {profile.location}
          </p>
          <h1 class="name">Chijun Sima</h1>
          <p class="role">
            {profile.jobTitle},{' '}
            <a href={profile.affiliationUrl} itemprop="affiliation" itemscope itemtype="https://schema.org/CollegeOrUniversity" target="_blank" rel="noopener noreferrer">
              <span itemprop="name">{profile.affiliation}</span>
            </a>
          </p>
          <p class="lede">
            PhD student in Computer Science at{' '}
            <a href={profile.affiliationUrl} target="_blank" rel="noopener noreferrer">UT Austin</a>, working on machine
            learning for systems and systems for machine learning. Previously Senior Software Development Engineer at
            Tencent's WeChat, where I led{' '}
            <em>Ekko</em> (OSDI '22). LLVM developer with commit access.
          </p>

          <div class="interests">
            <span class="interests-label" id="interests-label">Research interests</span>
            <ul aria-labelledby="interests-label">
              {profile.researchInterests.map((interest) => <li>{interest}</li>)}
            </ul>
          </div>

          <div class="contact-links" role="list" aria-label="Contact and profiles">
            <a class="btn btn-primary" role="listitem" href={`mailto:${profile.email}`} itemprop="email">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              Email
            </a>
            <a class="btn btn-ghost" role="listitem" href={scholarUrl} itemprop="sameAs" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5Z"/><path d="M6 11.5v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/></svg>
              Scholar
            </a>
            <a class="btn btn-ghost" role="listitem" href={linkedinUrl} itemprop="sameAs" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn
            </a>
          </div>
        </div>

        <div class="hero-photo">
          <picture>
            <source type="image/webp" srcset={avatar.webp.srcset} sizes={avatar.webp.sizes} />
            <img
              src={avatar.path}
              alt="Portrait of Chijun Sima"
              width="160"
              height="160"
              itemprop="image"
              class="avatar"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>

        <dl class="highlights" aria-label="Selected impact at WeChat">
          {highlights.map((stat) => (
            <div class="stat">
              <dt class="stat-value">
                {'prefix' in stat && <span class="stat-prefix">{stat.prefix}</span>}
                {stat.value}
              </dt>
              <dd class="stat-label">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Publications -->
      <section id="publications" aria-labelledby="h-pub">
        <h2 id="h-pub" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('publications')}</span>Publications</h2>
        <ol class="pub-list" reversed>
          {publications.map((pub) => (
            <li>
              <article class="pub-item" id={pub.id} itemscope itemtype="https://schema.org/ScholarlyArticle">
                <div class="pub-meta">
                  <span class="pub-venue">{pub.venue}</span>
                  <span class="pub-year">{pub.year}</span>
                </div>
                {pub.link ? (
                  <a href={pub.link} class="pub-title" itemprop="url" target="_blank" rel="noopener noreferrer">
                    <span itemprop="name">{pub.title}</span>{' '}
                    <svg class="pub-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
                  </a>
                ) : (
                  <span class="pub-title" itemprop="name">{pub.title}</span>
                )}
                <p class="pub-authors" set:html={pub.authors.replace(/Chijun Sima/g, '<strong class="pub-self" itemprop="author">Chijun Sima</strong>')} />
                {pub.note && pub.link && <p class="pub-note">{pub.note}</p>}
              </article>
            </li>
          ))}
        </ol>
        <p class="section-note">
          Full list on <a href={scholarUrl} class="text-link" target="_blank" rel="noopener noreferrer">Google Scholar</a>.
        </p>
      </section>

      <!-- Experience -->
      <section id="experience" aria-labelledby="h-exp">
        <h2 id="h-exp" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('experience')}</span>Experience</h2>
        <div class="timeline">
          {experience.map((entry, index) => (
            <article class:list={['entry', { 'is-current': !entry.endDate && index === 0, 'is-ongoing': !entry.endDate && index > 0 }]} itemscope itemtype="https://schema.org/OrganizationRole">
              <meta itemprop="startDate" content={entry.startDate} />
              {entry.endDate && <meta itemprop="endDate" content={entry.endDate} />}
              <div class="entry-when">
                {!entry.endDate && index === 0 && <span class="badge-current">Current</span>}
                <time datetime={entry.startDate}>{entry.period}</time>
                {entry.location && <span class="entry-where">{entry.location}</span>}
              </div>
              <div class="entry-body">
                <h3 class="entry-org">
                  <a href={entry.orgUrl} target="_blank" rel="noopener noreferrer" itemprop="memberOf" itemscope itemtype="https://schema.org/Organization">
                    <span itemprop="name">{entry.org}</span>
                  </a>
                </h3>
                <p class="entry-role">
                  <span itemprop="roleName">{entry.role}</span>
                  {entry.subtitle && <span class="sub"> · {entry.subtitle}</span>}
                </p>

                {entry.projects.map((proj) =>
                  proj.name ? (
                    <details class="project project-details">
                      <summary>
                        <span class="project-summary">
                          <span class="project-name">
                            {proj.name}
                            {proj.note && <span class="muted project-note"> ({proj.note})</span>}
                          </span>
                          {proj.headline && <span class="project-headline" set:html={proj.headline} />}
                        </span>
                        <span class="project-toggle" aria-hidden="true">Details</span>
                      </summary>
                      <ul class="bullets">
                        {proj.bullets.map((b) => <li set:html={b} />)}
                      </ul>
                    </details>
                  ) : (
                    <div class="project">
                      <ul class="bullets">
                        {proj.bullets.map((b) => <li set:html={b} />)}
                      </ul>
                    </div>
                  )
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section id="education" aria-labelledby="h-edu">
        <h2 id="h-edu" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('education')}</span>Education</h2>
        <div class="timeline">
          {education.map((entry, index) => (
            <article class:list={['entry', { 'is-current': !entry.endDate && index === 0, 'is-ongoing': !entry.endDate && index > 0 }]} itemprop={entry.endDate ? 'alumniOf' : 'affiliation'} itemscope itemtype="https://schema.org/EducationalOrganization">
              <div class="entry-when">
                {!entry.endDate && index === 0 && <span class="badge-current">Current</span>}
                <time datetime={entry.startDate}>{entry.period}</time>
              </div>
              <div class="entry-body">
                <h3 class="entry-org">
                  <a href={entry.schoolUrl} target="_blank" rel="noopener noreferrer">
                    <span itemprop="name">{entry.school}</span>
                  </a>
                </h3>
                <p class="entry-role">{entry.degree}</p>
                <p class="entry-detail">{entry.detail}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Talks -->
      <section id="talks" aria-labelledby="h-talks">
        <h2 id="h-talks" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('talks')}</span>Talks</h2>
        <div class="card">
          <p class="card-title">Ekko: A Large-Scale Deep Learning Recommender System with Low-Latency Model Update</p>
          <ul class="talk-list">
            {talks.map((t) => (
              <li><span>{t.text}</span><time>{t.date}</time></li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Service & Awards -->
      <section id="service" aria-labelledby="h-service">
        <h2 id="h-service" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('service')}</span>Service &amp; Awards</h2>
        <div class="two-col">
          <div class="card">
            <h3 class="side-label">Reviewer</h3>
            <ul class="tag-list">
              {reviewing.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div class="card">
            <h3 class="side-label">Awards</h3>
            <ul class="award-list">
              {awards.map((a) => (
                <li>
                  {a.year ? <span class="year">{a.year}</span> : <span class="year year-none" aria-hidden="true">·</span>}
                  <span>{a.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Write-ups -->
      <section id="writeups" aria-labelledby="h-writeups">
        <h2 id="h-writeups" class="section-heading"><span class="section-index" aria-hidden="true">{sectionNumber('writeups')}</span>Write-ups &amp; Links</h2>
        <ul class="writeup-links">
          {writeups.map((ref) => (
            <li>
              <a href={ref.href} target="_blank" rel="noopener noreferrer">
                <span>{ref.label}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="site-footer no-print" role="contentinfo">
        <p class="footer-links">
          <span>Machine-readable</span>
          {machineReadableResources.map((resource) => (
            <a href={resource.href}>{resource.label}</a>
          ))}
        </p>
        <p class="footer-meta">
          <span>Last updated <time datetime={lastUpdated}>{lastUpdated}</time></span>
          <span>&copy; <span id="year"></span> Chijun Sima</span>
        </p>
      </footer>
    </main>
  </div>
</BaseLayout>
