---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout>
  <a href="#main" class="skip-link">Skip to main content</a>

  <div class="page-wrapper">
    <main id="main" tabindex="-1">
      <header class="site-header">
        <div class="header-card">
          <div class="header-info">
            <h1 class="header-name">{profile.fullName}</h1>

            <div class="header-links" role="list" aria-label="Contact and profiles">
              <a role="listitem" href={`mailto:${profile.email}`}>Email</a>
              <a role="listitem" href={profile.scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar</a>
            </div>
          </div>
        </div>
      </header>
    </main>
  </div>
</BaseLayout>
