---
// Lightweight shell for utility pages (404): same fonts, theme and stylesheet as the
// homepage, but no structured data, analytics, or scripts.
import AssetHead from './AssetHead.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <AssetHead />
  </head>
  <body>
    <slot />
  </body>
</html>
