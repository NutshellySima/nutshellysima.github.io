---
import siteStyles from '../styles/site.css?url';
import { absoluteUrl, profile, siteMetadata } from '../data/profile';
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteMetadata.title}</title>
    <meta name="description" content={siteMetadata.description} />
    <meta name="author" content={siteMetadata.name} />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={absoluteUrl('/')} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={absoluteUrl('/')} />
    <meta property="og:title" content={siteMetadata.title} />
    <meta property="og:description" content={siteMetadata.description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": profile.fullName,
      "url": siteMetadata.url,
      "email": `mailto:${profile.email}`,
      "sameAs": [profile.scholarUrl],
    })} />

    <link rel="stylesheet" href={siteStyles} />
  </head>
  <body>
    <slot />
  </body>
</html>
