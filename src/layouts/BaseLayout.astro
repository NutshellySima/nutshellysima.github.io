---
import AssetHead from './AssetHead.astro';
import { withVersion } from '../data/assets';
import {
  absoluteUrl,
  advisors,
  avatar,
  lastUpdatedISO,
  profile,
  publications,
  siteMetadata,
  socialImage,
} from '../data/profile';

if (siteMetadata.description.length > 160) {
  throw new Error(`Meta description is ${siteMetadata.description.length} characters; keep it at 160 or fewer.`);
}

const scriptSrc = withVersion('/assets/site.mjs');
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <link rel="preload" as="image" type="image/webp" imagesrcset={avatar.webp.srcset} imagesizes={avatar.webp.sizes} fetchpriority="high" data-vite-ignore />
    <link rel="modulepreload" href={scriptSrc} data-vite-ignore />

    <!-- Critical: keep the avatar bounded even before the main stylesheet applies -->
    <style is:inline>
      .avatar{width:6.25rem;height:6.25rem;object-fit:cover;border-radius:50%}
      @media (min-width:62rem){.avatar{width:8.5rem;height:8.5rem;border-radius:1.5rem}}
    </style>

    <AssetHead />

    <title>{siteMetadata.pageTitle}</title>
    <meta name="description" content={siteMetadata.description} />
    <meta name="author" content={siteMetadata.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="keywords" content={siteMetadata.keywords.join(', ')} />

    <link rel="canonical" href={absoluteUrl('/')} />

    <!-- Preconnect to third-party analytics origins (improves Core Web Vitals) -->
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={absoluteUrl('/')} />
    <meta property="og:title" content={siteMetadata.pageTitle} />
    <meta property="og:description" content={siteMetadata.description} />
    <meta property="og:image" content={absoluteUrl(socialImage.path)} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:locale" content={siteMetadata.locale} />
    <meta property="og:updated_time" content={lastUpdatedISO} />
    <meta property="profile:first_name" content={profile.givenName} />
    <meta property="profile:last_name" content={profile.familyName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteMetadata.pageTitle} />
    <meta name="twitter:description" content={siteMetadata.description} />
    <meta name="twitter:image" content={absoluteUrl(socialImage.path)} />
    <meta name="twitter:image:alt" content={socialImage.alt} />


    <!-- LLM/AI agent discovery -->
    <link rel="alternate" type="text/plain" title="LLM context (concise)" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLM context (full)" href="/llms-full.txt" />
    <link rel="alternate" type="application/json" title="Machine-readable profile" href="/profile.json" />
    <link rel="alternate" type="application/json" title="Selected publications" href="/publications.json" />
    <link rel="alternate" type="application/feed+json" title="Updates feed" href="/feed.json" />
    <link rel="service-desc" type="application/oas+json" title="OpenAPI description" href="/openapi.json" />
    <link rel="alternate" type="application/json" title="Agent Skills discovery index" href="/.well-known/agent-skills/index.json" />


    <!-- JSON-LD: Person (rich structured data for search engines and LLM agents) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": `${siteMetadata.url}/#person`,
      "name": profile.fullName,
      "givenName": profile.givenName,
      "familyName": profile.familyName,
      "url": siteMetadata.url,
      "image": {
        "@type": "ImageObject",
        "url": absoluteUrl(avatar.path),
        "width": avatar.width,
        "height": avatar.height
      },
      "jobTitle": profile.jobTitle,
      "description": profile.description,
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": profile.affiliation,
        "department": { "@type": "Organization", "name": profile.department },
        "url": profile.affiliationUrl
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": profile.education.school,
        "url": profile.education.schoolUrl
      },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "degree",
        "name": profile.education.degree,
        "recognizedBy": {
          "@type": "CollegeOrUniversity",
          "name": profile.education.school
        }
      },
      "award": [
        "Tencent Technology Breakthrough Award (Gold Prize), 2022 — Project Lead, Ekko",
        "Bronze Medal, ACM-ICPC Asia Xi'an Regional Contest (2017)",
        "Second Prize, 15th China Collegiate Programming Contest (Guangdong Division)"
      ],
      "knowsAbout": profile.knowsAbout,
      "knows": advisors.map((advisor) => ({
        "@type": "Person",
        "name": advisor.name,
        "url": advisor.url,
        "jobTitle": advisor.title,
        "affiliation": { "@type": "CollegeOrUniversity", "name": advisor.affiliation }
      })),
      "email": `mailto:${profile.email}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": profile.locality,
        "addressRegion": profile.region,
        "addressCountry": profile.countryCode
      },
      "sameAs": profile.sameAs,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": absoluteUrl('/')
      }
    })} />

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${siteMetadata.url}/#website`,
      "url": absoluteUrl('/'),
      "name": siteMetadata.title,
      "description": siteMetadata.description,
      "author": { "@type": "Person", "@id": `${siteMetadata.url}/#person` },
      "datePublished": "2022-07-10T00:00:00+08:00",
      "dateModified": lastUpdatedISO,
      "inLanguage": siteMetadata.language
    })} />

    <!-- JSON-LD: ProfilePage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "@id": `${siteMetadata.url}/#profile-page`,
      "url": absoluteUrl('/'),
      "name": siteMetadata.title,
      "description": siteMetadata.description,
      "datePublished": "2022-07-10T00:00:00+08:00",
      "dateModified": lastUpdatedISO,
      "isPartOf": { "@id": `${siteMetadata.url}/#website` },
      "mainEntity": { "@id": `${siteMetadata.url}/#person` },
      "about": { "@id": `${siteMetadata.url}/#person` },
      "inLanguage": siteMetadata.language
    })} />

    <!-- JSON-LD: ScholarlyArticle for flagship paper -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "name": publications[0].title,
      "url": publications[0].link,
      "datePublished": publications[0].datePublished,
      "isPartOf": {
        "@type": "PublicationEvent",
        "name": publications[0].venueFull,
        "organizer": { "@type": "Organization", "name": "USENIX" }
      },
      "author": [
        { "@type": "Person", "name": "Chijun Sima", "@id": `${siteMetadata.url}/#person` },
        { "@type": "Person", "name": "Yao Fu" },
        { "@type": "Person", "name": "Man-Kit Sit" },
        { "@type": "Person", "name": "Liyi Guo" },
        { "@type": "Person", "name": "Xuri Gong" },
        { "@type": "Person", "name": "Feng Lin" },
        { "@type": "Person", "name": "Junyu Wu" },
        { "@type": "Person", "name": "Yongsheng Li" },
        { "@type": "Person", "name": "Haidong Rong" },
        { "@type": "Person", "name": "Pierre-Louis Aublin" },
        { "@type": "Person", "name": "Luo Mai" }
      ]
    })} />

    <!-- Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "74efc9100b074000b7c818e83d174ea4"}'></script>
    <script is:inline>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,'clarity','script','cr8ptqxm1m');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RDCCF82CG7"></script>
    <script is:inline>
      window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-RDCCF82CG7');
    </script>

  </head>
  <body class="font-sans antialiased">
    <slot />

    <script type="module" src={scriptSrc} data-vite-ignore defer></script>
  </body>
</html>
